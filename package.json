{
  "name": "nidokey",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "prisma generate && next build",
    "start": "next start -p 4200",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check-listings": "tsx scripts/check-listings.ts",
    "hash-photos": "tsx scripts/hash-existing-photos.ts",
    "fix-prices": "tsx scripts/fix-corrupt-prices.ts",
    "scraper": "node scripts/scraper-service.mjs",
    "claim-orphans": "tsx scripts/claim-orphan-properties.ts",
    "reset-food-menus": "node --env-file=.env --import tsx scripts/reset-food-menus.ts",
    "refresh": "tsx scripts/refresh-type.ts",
    "backfill-ratings": "node --env-file=.env --import tsx scripts/backfill-book-ratings.ts",
    "gen-province-images": "tsx scripts/gen-province-images.ts",
    "mobile": "npm --workspace @nidokey/mobile run start",
    "i18n:validate": "tsx scripts/i18n-validate.ts",
    "i18n:translate": "tsx scripts/i18n-translate.ts",
    "bot:eval": "node --env-file=.env --import tsx scripts/bot-eval/run.ts",
    "bot:eval:smoke": "node --env-file=.env --import tsx scripts/bot-eval/run.ts --smoke",
    "bot:export": "node --env-file=.env --import tsx scripts/bot-eval/export-real.ts",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "npm --workspace @nidokey/mobile exec -- tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"packages/shared/src/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@prisma/client": "^6.1.0",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "expo-asset": "~12.0.13",
    "expo-router": "~6.0.23",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.31",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "expo-asset": "~12.0.13"
  }
}
